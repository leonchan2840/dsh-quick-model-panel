{
  "name": "@leonchan2840/dsh-quick-model-panel",
  "version": "1.2.1",
  "license": "MIT",
  "type": "module",
  "description": "Keep favorite models, reasoning effort and agent teams in one persistent DSH panel, with fewer menu clicks and less scrolling.",
  "keywords": ["dsh-plugin", "deepseek-harness", "model-selector", "reasoning", "agent-teams"],
  "repository": { "type": "git", "url": "git+https://github.com/leonchan2840/dsh-quick-model-panel.git" },
  "homepage": "https://github.com/leonchan2840/dsh-quick-model-panel#readme",
  "bugs": { "url": "https://github.com/leonchan2840/dsh-quick-model-panel/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": { "dsh": "0.2.2-rc.3" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "SECURITY.md", "docs/images/*.png", "build.cjs", "src", "test"],
  "scripts": { "build": "node build.cjs", "test": "node --test" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-api-remotes"] }
  }
}
