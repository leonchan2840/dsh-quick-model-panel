{
  "name": "@local/dsh-quick-model-panel",
  "version": "1.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A persistent composer picker for starred models, reasoning effort and agent teams.",
  "engines": { "dsh": "0.2.2-rc.3" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": { "build": "node build.cjs", "test": "node --test" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-api-remotes"] }
  }
}
